{
  "name": "nestjs-resend",
  "version": "1.1.1",
  "description": "NestJS provider for sending emails with resend",
  "author": "paullee",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "test": "npm run build && npm run test:types && node --test test/*.test.cjs test/*.test.mjs",
    "test:types": "tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{cts,mts,cjs,mjs}\""
  },
  "dependencies": {
    "resend": "^6.4.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/testing": "^12.2.0",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.1.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "rxjs": "^7.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangtaste/nestjs-resend.git"
  },
  "keywords": [
    "nestjs",
    "nest",
    "resend",
    "mailgun",
    "email"
  ],
  "bugs": {
    "url": "https://github.com/jiangtaste/nestjs-resend/issues"
  },
  "homepage": "https://github.com/jiangtaste/nestjs-resend#readme"
}
